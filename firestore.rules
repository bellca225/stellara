// Stellara Firestore Security Rules
//
// 작성: 2026-05-09 (TASKS.md T16.5 초안)
// 수정: 2026-06-03
//   - friendships: list 와 get 규칙 분리 → array-contains 쿼리 PERMISSION_DENIED 수정
//   - friendRequests: list 와 get 규칙 분리 → fromUid/toUid 쿼리 허용
//   - synastryCaches: list 규칙 추가 (read 규칙이 list 쿼리를 막던 버그 수정)
//   - dailyFortunes: list 규칙 추가
//
// [중요] Firestore Security Rules v2 에서 list 쿼리와 get 단건 조회는 별도 규칙이 필요.
// list 규칙에서 resource.data 를 참조하면 query 레벨에서 평가가 불가능해
// PERMISSION_DENIED 가 발생한다. list 는 인증 여부만 확인하고,
// 실제 데이터 접근 제어는 get 과 쿼리 필터 조합으로 처리한다.
//
// 적용 방법
//   firebase deploy --only firestore:rules
//   또는 Firebase Console → Firestore → 규칙 탭에서 본 파일 내용 붙여넣기 후 게시

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function favoritesOk(data) {
      return !('favoriteIds' in data) || data.favoriteIds.size() <= 3;
    }

    // ── loginIds: 아이디 중복 방지 인덱스 ────────────────────────────
    // 아이디 존재 여부는 미인증 상태에서도 확인 가능 (회원가입 중복 검사).
    // 쓰기는 트랜잭션으로만 (클라이언트 직접 쓰기 차단).
    match /loginIds/{loginId} {
      allow read: if true; // 중복 검사는 미인증 허용
      allow write: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    // ── users: 사용자 프로필 + 출생정보 ───────────────────────────
    // read 는 인증된 사용자 전체 허용 (친구 검색/궁합에서 닉네임/birthInfo 일부 필요)
    // write 는 본인만, favoriteIds 는 최대 3명
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && favoritesOk(request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.uid == uid
        && favoritesOk(request.resource.data);
      allow delete: if false;
    }

    // ── friendCodes: 친구 코드 인덱스 ─────────────────────────────
    // 본인 uid 가 박힌 문서만 본인이 쓰기. 검색은 인증된 사용자라면 read OK
    match /friendCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ── charts: 나탈 차트 캐시 ────────────────────────────────────
    match /charts/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // ── dailyFortunes: 운세 캐시 ─────────────────────────────────
    // list 쿼리와 get 단건을 분리. list 는 인증만 확인 (쿼리 필터가 uid 보장).
    match /dailyFortunes/{docId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if isSignedIn(); // 쿼리는 항상 본인 uid 로 필터됨
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ── friendRequests: 친구 요청 ────────────────────────────────
    // [수정] list 와 get 분리:
    //   - list: 인증된 사용자 허용 (fromUid/toUid 쿼리 필터가 당사자만 반환 보장)
    //   - get:  fromUid 또는 toUid 가 본인인 문서만 허용
    // 생성은 본인이 fromUid 일 때, 상태는 'pending' 으로 시작
    // 수락/거절(update)은 toUid 만, 취소(delete)는 fromUid 가 pending 일 때만
    match /friendRequests/{requestId} {
      allow get: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow list: if isSignedIn(); // fromUid/toUid == auth.uid 쿼리만 클라이언트에서 사용
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && (
          // 수락/거절: toUid 가 본인
          (resource.data.toUid == request.auth.uid
            && request.resource.data.status in ['accepted', 'rejected'])
          ||
          // 취소: fromUid 가 본인이고 pending → cancelled
          (resource.data.fromUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled')
        );
      allow delete: if isSignedIn()
        && resource.data.fromUid == request.auth.uid
        && resource.data.status == 'pending';
    }

    // ── friendships: 수락된 친구 관계 ────────────────────────────
    // [수정] list 와 get 분리:
    //   - list: 인증된 사용자 허용 (array-contains 쿼리가 멤버 여부 보장)
    //   - get:  uids 에 본인이 포함돼야 함 (resource == null 허용: 존재 여부 확인용)
    match /friendships/{pairKey} {
      allow get: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.uids);
      allow list: if isSignedIn(); // array-contains uid == auth.uid 쿼리만 클라이언트에서 사용
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() == 2;
      allow update: if false;
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.uids;
    }

    // ── synastryCaches: 궁합 캐시 ────────────────────────────────
    // [수정] list 와 get 분리:
    //   - list: 인증된 사용자 허용 (uid 쿼리 필터 보장)
    //   - get:  userIds 에 본인이 포함돼야 함
    match /synastryCaches/{docId} {
      allow get: if isSignedIn()
        && request.auth.uid in resource.data.userIds;
      allow list: if isSignedIn(); // uid 관련 쿼리만 클라이언트에서 사용
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2;
      allow update, delete: if false;
    }

    // ── 그 외 문서/컬렉션 ────────────────────────────────────────
    // 명시되지 않은 모든 경로는 기본 거부 (rules_version='2' 기본 동작)
  }
}
