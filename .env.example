# ── Prokerala 기본 credential ─────────────────────────────
PROKERALA_CLIENT_ID=여기에_Client_ID_입력
PROKERALA_CLIENT_SECRET=여기에_Client_Secret_입력

# 선택: 팀 내 backup credential
PROKERALA_CLIENT_ID_SEOYEON=
PROKERALA_CLIENT_SECRET_SEOYEON=
PROKERALA_CLIENT_ID_SEONWOO=
PROKERALA_CLIENT_SECRET_SEONWOO=
PROKERALA_CLIENT_ID_DOYEON=
PROKERALA_CLIENT_SECRET_DOYEON=

# ── Prokerala 운영 정책 ───────────────────────────────────
PROKERALA_BASE_URL=https://api.prokerala.com
PROKERALA_TOKEN_URL=https://api.prokerala.com/token
PROKERALA_REMOTE_ENABLED=false
USE_FIXTURE_IN_DEBUG=true

# ── AI 운영 정책 ─────────────────────────────────────────
# AI_REMOTE_ENABLED=false 가 기본. owner 승인 후에만 true로 변경.
AI_REMOTE_ENABLED=true

# AI 프로바이더 설정 — 우선순위: Gemini → OpenAI → Anthropic
# AI_PROVIDER_DEFAULT: 'gemini' | 'openai' | 'anthropic' | 'auto'(순서대로 시도)
AI_PROVIDER_DEFAULT=auto
# AI_PROVIDER_ORDER: fallback 순서. 키가 없는 프로바이더는 자동 건너뜀.
AI_PROVIDER_ORDER=gemini,openai,anthropic

# ── Gemini (1순위 — 키 추가 시 자동 활성화) ─────────────
# https://aistudio.google.com/app/apikey 에서 무료 발급 가능
GEMINI_API_KEY=
# 기본 모델 (gemini-2.5-flash: 빠르고 무료 quota 있음)
AI_MODEL_GEMINI_DEFAULT=gemini-2.5-flash

# ── OpenAI (2순위 fallback) ───────────────────────────────
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=
# 랜덤 질문용 모델 (기본값: gpt-4o-mini — 비용/속도 최적)
AI_MODEL_OPENAI_DEFAULT=gpt-4o-mini

# ── Anthropic (3순위 fallback) ────────────────────────────
# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=
# fallback용 경량 모델
AI_MODEL_ANTHROPIC_DEFAULT=claude-3-5-haiku-latest

# ── Web Firebase (Chrome 실행 시 필요) ───────────────────
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
